<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:canvas="clr-namespace:Content.Client._AS.CanvasDesign.UI"
                      Title="{Loc 'canvas-design-history-title'}"
                      SetSize="900 600"
                      MinSize="760 480">
  <BoxContainer Orientation="Horizontal" Margin="8">
    <BoxContainer Orientation="Vertical" MinWidth="350" Margin="0 0 8 0">
      <Label Text="{Loc 'canvas-design-history-revisions'}" StyleClasses="LabelHeading" />
      <LineEdit Name="HistorySearch" PlaceHolder="{Loc 'canvas-design-history-search'}" Margin="0 4 0 6" />
      <ItemList Name="HistoryList" SelectMode="Button" VerticalExpand="True" />
    </BoxContainer>
    <PanelContainer StyleClasses="AngleRect" MinWidth="2" />
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="8 0 0 0">
      <Label Name="SignName" StyleClasses="LabelHeading" HorizontalAlignment="Center" />
      <Label Name="SavedBy" HorizontalAlignment="Center" />
      <Label Name="ChangedAt" HorizontalAlignment="Center" />
      <RichTextLabel Name="SignDescription" Margin="0 4 0 8" />
      <canvas:CanvasDesignControl Name="Canvas" MouseFilter="Ignore" HorizontalAlignment="Center" VerticalExpand="True" />
      <Button Name="ExportButton" Text="{Loc 'canvas-design-export'}" HorizontalAlignment="Right" Disabled="True" />
    </BoxContainer>
  </BoxContainer>
</controls:FancyWindow>
