<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'canvas-design-close-title'}"
               Resizable="False">
  <BoxContainer Orientation="Horizontal" SeparationOverride="4" MinSize="200 40">
    <Button Name="SaveButton" Text="{Loc 'canvas-design-close-save'}" StyleClasses="ButtonBig" />
    <Button Name="SaveDraftButton" Text="{Loc 'canvas-design-close-save-draft'}" StyleClasses="ButtonBig" />
    <Button Name="NoSaveButton" Text="{Loc 'canvas-design-close-nosave'}" StyleClasses="ButtonBig" />
    <Button Name="CancelButton" Text="{Loc 'canvas-design-close-cancel'}" StyleClasses="ButtonBig" />
  </BoxContainer>
</DefaultWindow>
