<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc pos-tip-window-title}"
    MinSize="320 280"
    SetSize="320 280">
    <BoxContainer Orientation="Vertical" Margin="10" VerticalExpand="True">
        <Label Text="{Loc pos-tip-select}" StyleClasses="LabelHeading"/>
        <Label Name="TipPreviewLabel" StyleClasses="LabelHeadingBigger"/>

        <Control MinHeight="8"/>

        <GridContainer Columns="2" HSeparationOverride="4" VSeparationOverride="4">
            <Button Name="Tip15Button" Text="{Loc pos-tip-15}"/>
            <Button Name="Tip18Button" Text="{Loc pos-tip-18}"/>
            <Button Name="Tip20Button" Text="{Loc pos-tip-20}"/>
            <Button Name="Tip25Button" Text="{Loc pos-tip-25}"/>
        </GridContainer>

        <Control MinHeight="4"/>
        <Button Name="CustomButton" Text="{Loc pos-tip-custom}" HorizontalExpand="True"/>
        <BoxContainer Name="CustomRow" Orientation="Horizontal" HorizontalExpand="True" Visible="False">
            <LineEdit Name="CustomBox" PlaceHolder="{Loc nanobank-input-placeholder}" HorizontalExpand="True"/>
            <Control MinWidth="4"/>
            <Button Name="CustomConfirmButton" Text="{Loc pos-tip-custom-confirm}"/>
        </BoxContainer>
        <Control MinHeight="4"/>
        <Button Name="NoTipButton" Text="{Loc pos-tip-none}" HorizontalExpand="True"/>

        <Control VerticalExpand="True"/>
        <Label Text="{Loc pos-tip-pretax}" StyleClasses="LabelSubText" HorizontalAlignment="Center"/>
    </BoxContainer>
</controls:FancyWindow>
