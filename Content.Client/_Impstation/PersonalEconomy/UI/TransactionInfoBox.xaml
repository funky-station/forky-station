<controls:TransactionInfoBox
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Impstation.PersonalEconomy.UI"
    HorizontalExpand="True"
    MouseFilter="Stop">
    <PanelContainer StyleClasses="ButtonSquare">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 4">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Name="DescriptionLabel"/>
                <Label Name="AmountLabel" StyleClasses="LabelSubText"/>
            </BoxContainer>
            <Label Name="CategoryLabel" StyleClasses="LabelSubText" VerticalAlignment="Center"/>
        </BoxContainer>
    </PanelContainer>
</controls:TransactionInfoBox>
