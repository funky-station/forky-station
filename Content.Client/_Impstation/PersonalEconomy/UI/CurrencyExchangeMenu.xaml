<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc currency-exchange-window-title}"
    MinSize="360 240"
    SetSize="360 240">
    <BoxContainer Orientation="Vertical" Margin="12" VerticalExpand="True">
        <Label Text="{Loc currency-exchange-title}" StyleClasses="LabelHeading"/>
        <Label Name="RateLabel" StyleClasses="LabelSubText"/>

        <Control VerticalExpand="True"/>

        <Label Name="SlotLabel" HorizontalAlignment="Center"/>
        <Label Name="PreviewLabel" StyleClasses="LabelHeadingBigger" HorizontalAlignment="Center"/>

        <Control VerticalExpand="True"/>

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <Button Name="InsertButton" Text="{Loc currency-exchange-insert-button}" HorizontalExpand="True"/>
            <Control MinWidth="4"/>
            <Button Name="EjectButton" Text="{Loc currency-exchange-eject-button}" HorizontalExpand="True"/>
        </BoxContainer>
        <Control MinHeight="4"/>
        <Button Name="ConvertButton" Text="{Loc currency-exchange-convert-button}" HorizontalExpand="True"/>
    </BoxContainer>
</controls:FancyWindow>
