<controls:Keypad
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Impstation.PersonalEconomy.UI">
    <BoxContainer Orientation="Vertical" HorizontalExpand="False" HorizontalAlignment="Left">
        <LineEdit Name="NumberDisplay" HorizontalExpand="True" PlaceHolder="0000"/>
        <GridContainer Name="ButtonGrid" Columns="3" VSeparationOverride="2" HSeparationOverride="2">
            <Button Name="OneButton" Text="1" MinSize="40 40"/>
            <Button Name="TwoButton" Text="2" MinSize="40 40"/>
            <Button Name="ThreeButton" Text="3" MinSize="40 40"/>
            <Button Name="FourButton" Text="4" MinSize="40 40"/>
            <Button Name="FiveButton" Text="5" MinSize="40 40"/>
            <Button Name="SixButton" Text="6" MinSize="40 40"/>
            <Button Name="SevenButton" Text="7" MinSize="40 40"/>
            <Button Name="EightButton" Text="8" MinSize="40 40"/>
            <Button Name="NineButton" Text="9" MinSize="40 40"/>
            <Button Name="EnterButton" Text="O" MinSize="40 40"/>
            <Button Name="ZeroButton" Text="0" MinSize="40 40"/>
            <Button Name="ClearButton" Text="X" MinSize="40 40"/>
        </GridContainer>
    </BoxContainer>
</controls:Keypad>
