<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
               Title="{Loc 'handheld-news-reader-window-title'}"
               MinSize="576 420"
               SetSize="576 420">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="5,5,5,5">
            <Button
                Name="Prev"
                Access="Public"
                MinWidth="64"
                Disabled="True"
                HorizontalAlignment="Left"
                Text="{Loc 'news-read-ui-prev-text'}"
                ToolTip="{Loc 'news-read-ui-prev-tooltip'}"
                HorizontalExpand="True"/>
            <Button
                Name="Next"
                Access="Public"
                MinWidth="64"
                Disabled="True"
                HorizontalAlignment="Right"
                Text="{Loc 'news-read-ui-next-text'}"
                ToolTip="{Loc 'news-read-ui-next-tooltip'}"/>
        </BoxContainer>
        <controls:StripeBack Name="ArticleNameContainer" Access="Public">
            <PanelContainer>
                <Label Name="PageNum" Access="Public" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                <Label Name="PageName" Access="Public" Align="Center"/>
            </PanelContainer>
        </controls:StripeBack>
        <PanelContainer VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#80808005" />
            </PanelContainer.PanelOverride>
            <ScrollContainer
                    HScrollEnabled="False"
                    HorizontalExpand="True"
                    MinSize="0 0"
                    VerticalExpand="True">
                <RichTextLabel Margin="8,8,8,8" Name="PageText" Access="Public" VerticalAlignment="Top"/>
            </ScrollContainer>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="5,5,5,5">
            <RichTextLabel Margin="5,2,2,2" Name="ShareTime" Access="Public" VerticalAlignment="Top"/>
            <customControls:VSeparator Margin="2 0"/>
            <RichTextLabel Margin="5,2,2,2" Name="Author" Access="Public" VerticalAlignment="Top" HorizontalAlignment="Right"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
