<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               MinSize="300 220"
               SetSize="320 240"
               Title="{Loc 'megaphone-window-title'}">
    <BoxContainer Orientation="Vertical" Margin="4 4 4 4" VerticalExpand="True">
        <PanelContainer VerticalExpand="True" Margin="0 0 0 4">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" BorderColor="#606060" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <TextEdit Name="MessageEdit" VerticalExpand="True" Margin="4 4 4 4" />
        </PanelContainer>
        <Button Name="CallStrikeButton" HorizontalAlignment="Right" />
    </BoxContainer>
</DefaultWindow>
