<DefaultWindow xmlns="https://spacestation14.io"
               MinSize="300 140"
               Title="{Loc 'union-clipboard-claim-window-title'}">
    <BoxContainer Orientation="Vertical" Margin="8 8 8 8" SeparationOverride="8">
        <Label Text="{Loc 'union-clipboard-claim-prompt'}"
               HorizontalExpand="True"
               Align="Center" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
            <Button Name="YesButton" Text="{Loc 'union-clipboard-claim-yes'}" />
            <Button Name="NoButton" Text="{Loc 'union-clipboard-claim-no'}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
