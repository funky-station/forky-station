gun-execution-verb-name = Execute
gun-execution-verb-message = Press your weapon to their head and pull the trigger.

gun-execution-initial-self = You press {THE($weapon)} against the head of {$victim}.
gun-execution-initial-others = { CAPITALIZE(THE($attacker)) } presses {POSS-ADJ($attacker)} {$weapon} against the head of { THE($victim) }.

gun-execution-complete-self = You shoot {$victim} in the head.
gun-execution-complete-others = { CAPITALIZE(THE($attacker)) } shoots {$victim} in the head.

gun-execution-empty-self = The chamber is empty.
gun-execution-empty-others = { CAPITALIZE(THE($attacker)) } pulls the trigger, but nothing happens.

gun-execution-suicide-initial-self = You press {THE($weapon)} to your temple...
gun-execution-suicide-initial-others = { CAPITALIZE(THE($attacker)) } presses {POSS-ADJ($attacker)} {$weapon} to their own temple.
gun-execution-suicide-complete-self = You shoot yourself in the head!
gun-execution-suicide-complete-others = {$attacker} shoots {REFLEXIVE($attacker)} in the head!

