funky-doc-cmd-01-name = CMD-01 Promotion Form
funky-doc-cmd-01-desc = Documentation used by Command personnel to formalize promotions.

funky-doc-cmd-02-name = CMD-02 Demotion Form
funky-doc-cmd-02-desc = Documentation used by Command personnel to formalize demotions.

funky-doc-cmd-03-name = CMD-03 Termination Form
funky-doc-cmd-03-desc = Documentation used by Command personnel to formalize terminations.

funky-doc-cmd-04-name = CMD-04 Command Performance Review
funky-doc-cmd-04-desc = A template used by the Corporate Liaison to review a given Command member's capabilities.

funky-doc-eng-01-name = ENG-01 Engine Status Report
funky-doc-eng-01-desc = A summary on the state of the station's engine(s), to be submitted by the Chief Engineer.

funky-doc-iab-01-name = IAB-01 Major SOP Violation Form
funky-doc-iab-01-desc = Paperwork to be filled out by Internal Affairs in the event of a major breach of Standard Operating Procedure.

funky-doc-iab-02-name = IAB-02 Department Review Form
funky-doc-iab-02-desc = A review of a department's conduct, to be submitted by an Internal Affairs Agent.

funky-doc-sec-01-name = DOC-ARR / SEC-01 Arrest Record
funky-doc-sec-01-desc = A form to be filled out after an arrest. Send to the Commandant when complete.

funky-doc-sec-02-name = DOC-SRW / SEC-02 Search Warrant
funky-doc-sec-02-desc = A form to be filled out and approved before conducting a search. Send to the Executive Officer for approval.

funky-doc-rnd-01-name = RND-01 Anomaly Report
funky-doc-rnd-01-desc = A report on a spatial anomaly discovered on the station.

funky-doc-rnd-02-name = RND-02 Artifact Log
funky-doc-rnd-02-desc = A summary of scientific research conducted on a xenoarcheological artifact.
