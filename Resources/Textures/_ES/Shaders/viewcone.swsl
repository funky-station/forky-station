// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
// !! Thank You Bhijn God (TYBG) & AI Peer for this stabilized shader !!
// !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

uniform sampler2D SCREEN_TEXTURE;
uniform highp float Zoom;

uniform highp float ConeAngle;
uniform highp float ConeFeather;
uniform highp float ConeIgnoreRadius;
uniform highp float ConeIgnoreFeather;

uniform highp float ViewAngle;
uniform highp float DarkenAmount;

// Uniform holding the raw Clyde Viewport world boundary corners
varying highp vec2 worldPosition;

// Number of pixels per tile
const lowp float PixelatedRes = 1.0 / 8.0;

void vertex()
{
    highp vec3 worldVertex = inverse(viewMatrix) * inverse(projectionMatrix) * vec3(VERTEX, 1.0);
    worldPosition = worldVertex.xy;
}

void fragment(){
    highp vec2 pixelSize = vec2(1.0/SCREEN_PIXEL_SIZE.x, 1.0/SCREEN_PIXEL_SIZE.y);
    highp vec4 color = zTextureSpec(SCREEN_TEXTURE, Pos);

    // Pixelate the world pos
    highp vec2 pixelatedWorld = round(worldPosition / PixelatedRes) * PixelatedRes;

    // Convert from world space to screen space
    highp vec3 pixelatedScreenPosition = projectionMatrix * viewMatrix * vec3(pixelatedWorld, 1.0);
    highp vec2 ScreenUV = (pixelatedScreenPosition.xy + vec2(1.0)) * 0.5;
    
	// Now round the screen space UVs to the nearest pixel
    highp vec2 hardwarePixelIndex = round(ScreenUV * pixelSize);
    highp vec2 FinalSamplePos = (hardwarePixelIndex + vec2(0.5)) * SCREEN_PIXEL_SIZE;
    FinalSamplePos = clamp(FinalSamplePos, vec2(0.0), vec2(1.0));

    highp vec4 PixelatedColor = zTextureSpec(SCREEN_TEXTURE, FinalSamplePos);

    // Cone stuff
    highp float mask = 1.0;
    highp float radial = zCircleGradient(pixelSize, FRAGCOORD.xy, 1.0, (ConeIgnoreFeather) / 1.0, (ConeIgnoreRadius / pow(ConeIgnoreFeather, 0.85)) / Zoom, 1.0);
    mask -= radial;

    highp vec2 delta = FRAGCOORD.xy - (pixelSize * 0.5);
    highp float deltaAngle = atan(delta.x, delta.y);
    deltaAngle += ViewAngle;
    deltaAngle = mod(deltaAngle, radians(360.0));
    deltaAngle = abs(radians(180.0) - mod(deltaAngle, radians(360.0)));

    highp float radAngle = radians(ConeAngle);
    highp float radFeather = radians(ConeFeather) + pow(1.0 - radial, 2.0);
    deltaAngle = 1.0 - clamp((deltaAngle - (radAngle * 0.5)) + (radFeather * 0.5), 0.0, radFeather) / radFeather;
    mask += clamp(deltaAngle, 0.0, 1.0);
    mask = 1.0 - clamp(mask, 0.0, 1.0);
	
	// add some extra gradient
	lowp float PixelRadialGradient = zCircleGradient(pixelSize, FRAGCOORD.xy, 1.0, 150.0, 0.0, 1.0);
	mask *= PixelRadialGradient;

    highp vec3 desaturated = mix(color.rgb, PixelatedColor.rgb, mask);
    highp vec3 darkened = mix(desaturated, vec3(0.0), mask * DarkenAmount);

    COLOR = vec4(darkened, color.a);
}